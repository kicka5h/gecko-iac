# homelab-postgres.snack — Gecko Snack Module
#
# A snack is a reusable, parameterized bundle of spawn blocks.
# Consume this snack in any .scute file:
#
#   snack "homelab-postgres" from "./homelab-postgres.snack"
#     namespace: "my-namespace"
#     replicas:  3
#   end
#
# Then access emitted values:
#   signal "endpoint"
#     value: homelab-postgres.endpoint
#   end

export "homelab-postgres"
  # ── Parameters ───────────────────────────────────────────────────────────────
  # Parameters let callers customize this module.
  # Declare types and defaults; callers override in their snack block.
  param namespace  string: "homelab-postgres"
  param replicas   number: 2
  param image      string: "nginx:latest"
  param port       number: 8080

  # ── Computed locals ───────────────────────────────────────────────────────────
  camouflage
    labels:
      app:        "homelab-postgres"
      managed-by: "gecko"
    end
  end

  # ── Resources this snack spawns ───────────────────────────────────────────────
  spawn "k8s:namespace" as "ns"
    name:   namespace
    labels: labels
  end

  spawn "k8s:deployment" as "app"
    needs:     @ns
    namespace: @ns.name
    image:     image
    replicas:  replicas

    ports:
      container_port: port
    end
  end

  spawn "k8s:service" as "svc"
    needs:       @app
    namespace:   @ns.name
    port:        port
    target_port: port
  end

  # ── Emitted values (accessible as homelab-postgres.signal_name) ─────────────────────────────
  emit "namespace"
    value: @ns.name
  end

  emit "endpoint"
    value: "http://#{namespace}.svc.cluster.local:#{port}"
  end

  emit "service_name"
    value: @svc.name
  end
end
