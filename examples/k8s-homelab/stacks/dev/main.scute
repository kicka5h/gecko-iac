territory "k8s-homelab"
  workspace: "dev"
end

habitat "kind"
end

habitat "k8s"
  kubeconfig: "~/.kube/config"
  context:    "kind-gecko-test"
end

// ─── Marks (inputs / variables) ───────────────────────────────────────────────

mark app_name    string:  "homelab-nginx"
mark image_tag   string:  "1.25-alpine"
mark replicas    number:  2
mark base_domain string:  "homelab.local"

// ─── Camouflage (computed locals) ─────────────────────────────────────────────

camouflage
  is_prod: workspace == "prod"
  common_tags:
    managed-by: "gecko"
    project:    "k8s-homelab"
    env:        workspace
  end
end

// ─── Kind Cluster ─────────────────────────────────────────────────────────────

spawn "kind:cluster" as "gecko-test"
  name: "gecko-test"
end

// ─── Namespace ────────────────────────────────────────────────────────────────

spawn "k8s:namespace" as "homelab"
  needs:  @gecko-test
  labels:
    managed-by: "gecko"
    env:        workspace
  end
end

// ─── ConfigMap: nginx configuration ──────────────────────────────────────────

spawn "k8s:configmap" as "nginx-config"
  needs:     @homelab
  namespace: "homelab"
  data:
    nginx_conf:  "server { listen 80; server_name #{base_domain}; location / { root /usr/share/nginx/html; index index.html; } }"
    server_name: base_domain
    worker_procs: "auto"
  end
  labels:
    app:        app_name
    managed-by: "gecko"
  end
end

// ─── Deployment: nginx ────────────────────────────────────────────────────────

spawn "k8s:deployment" as "homelab-nginx"
  needs:     @homelab
  needs:     @nginx-config
  namespace: "homelab"
  image:     "nginx:#{image_tag}"
  ports:     [80]

  when is_prod
    replicas: replicas * 3
  else
    replicas: replicas
  end

  env:
    NGINX_HOST:   base_domain
    NGINX_PORT:   "80"
    ENVIRONMENT:  workspace
  end

  resources:
    requests:
      cpu:    "100m"
      memory: "128Mi"
    end
    limits:
      cpu:    "500m"
      memory: "256Mi"
    end
  end

  labels:
    app:        app_name
    managed-by: "gecko"
    version:    image_tag
  end
end

// ─── Service: NodePort for easy local access ──────────────────────────────────

spawn "k8s:service" as "homelab-nginx-svc"
  needs:       @homelab-nginx
  namespace:   "homelab"
  port:        80
  target_port: 80
  type:        "NodePort"
  node_port:   30080
  selector:
    app: app_name
  end
  labels:
    app:        app_name
    managed-by: "gecko"
  end
end

// ─── Signals (outputs) ────────────────────────────────────────────────────────

signal "service_endpoint"
  value:       "http://#{base_domain}:30080"
  description: "External URL for the homelab nginx service"
end

signal "namespace"
  value:       "homelab"
  description: "Kubernetes namespace where resources are deployed"
end
