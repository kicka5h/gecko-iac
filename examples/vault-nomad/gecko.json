{
  "name": "vault-nomad",
  "runtime": "scute",
  "workspace": "dev",
  "workspaces": ["dev", "staging", "prod"],
  "providers": {
    "vault": {
      "type": "vault",
      "config": {
        "address": "http://127.0.0.1:8200",
        "token": "root"
      }
    },
    "nomad": {
      "type": "nomad",
      "config": {
        "address": "http://127.0.0.1:4646"
      }
    }
  },
  "backend": {
    "type": "local"
  }
}
