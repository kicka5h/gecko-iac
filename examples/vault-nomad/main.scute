territory "vault-nomad"
  workspace: "dev"
end

store "local"
end

habitat "vault"
  address: "http://127.0.0.1:8200"
  token:   env("VAULT_TOKEN") | "root"
end

habitat "nomad"
  address: env("NOMAD_ADDR") | "http://127.0.0.1:4646"
end

// ─── Marks ────────────────────────────────────────────────────────────────────

mark app_name   string: "myapp"
mark app_image  string: "nginx:1.25-alpine"
mark app_count  number: 2
mark datacenter string: "dc1"

// ─── Camouflage ───────────────────────────────────────────────────────────────

camouflage
  is_prod:   workspace == "prod"
  app_count_actual: is_prod ? app_count * 3 : app_count
end

// ─── Vault: Secrets Engine ────────────────────────────────────────────────────

spawn "vault:mount" as "kv"
  path: "secret"
  type: "kv-v2"
end

spawn "vault:mount" as "pki"
  path:        "pki"
  type:        "pki"
  description: "PKI secrets engine for TLS certificates"
end

// ─── Vault: Policies ─────────────────────────────────────────────────────────

spawn "vault:policy" as "app-read"
  needs: @kv
  name:  "#{app_name}-read"
  rules: "path \"secret/data/#{app_name}/*\" { capabilities = [\"read\", \"list\"] }"
end

spawn "vault:policy" as "app-write"
  needs: @kv
  name:  "#{app_name}-write"
  rules: "path \"secret/data/#{app_name}/*\" { capabilities = [\"create\", \"update\", \"read\", \"list\", \"delete\"] }"
end

// ─── Vault: Auth Methods ──────────────────────────────────────────────────────

spawn "vault:auth" as "approle"
  path:        "approle"
  type:        "approle"
  description: "AppRole auth for Nomad workloads"
end

// ─── Vault: Secrets ───────────────────────────────────────────────────────────

spawn "vault:secret" as "db-creds"
  needs: @kv
  path:  "#{app_name}/db"
  data:
    username: "#{app_name}_user"
    password: "changeme"
    host:     "postgres.service.consul"
    port:     "5432"
  end
end

spawn "vault:secret" as "app-config"
  needs: @kv
  path:  "#{app_name}/config"
  data:
    environment: workspace
    log_level:   "info"
    port:        "8080"
  end
end

// ─── Nomad: Namespaces ────────────────────────────────────────────────────────

spawn "nomad:namespace" as "apps"
  name:        "apps"
  description: "Application workloads"
end

spawn "nomad:namespace" as "infra"
  name:        "infra"
  description: "Infrastructure services"
end

// ─── Nomad: ACL Policies ──────────────────────────────────────────────────────

spawn "nomad:policy" as "app-operator"
  needs:       @apps
  name:        "app-operator"
  description: "Read and submit jobs in the apps namespace"
  rules: "namespace \"apps\" { policy = \"write\" } agent { policy = \"read\" } node { policy = \"read\" }"
end

// ─── Nomad: Jobs ─────────────────────────────────────────────────────────────

spawn "nomad:job" as "nginx"
  needs:       @apps
  id:          app_name
  type:        "service"
  namespace:   "apps"
  datacenters: [datacenter]
  image:       app_image
  count:       app_count_actual
  cpu:         100
  memory:      128
  port:        80
  env:
    ENVIRONMENT: workspace
    APP_NAME:    app_name
  end
end

// ─── Signals ─────────────────────────────────────────────────────────────────

signal "vault_secret_path"
  value:       "secret/data/#{app_name}/db"
  description: "Path to database credentials in Vault"
end

signal "nomad_job_id"
  value:       app_name
  description: "Nomad job ID for the application"
end
