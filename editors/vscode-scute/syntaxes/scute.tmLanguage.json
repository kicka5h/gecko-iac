{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scute",
  "scopeName": "source.scute",
  "fileTypes": ["scute", "snack"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#spawn-declaration" },
    { "include": "#mark-declaration" },
    { "include": "#block-keywords" },
    { "include": "#control-keywords" },
    { "include": "#end-keyword" },
    { "include": "#type-hints" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#raw-strings" },
    { "include": "#numbers" },
    { "include": "#resource-refs" },
    { "include": "#builtin-functions" },
    { "include": "#operators" },
    { "include": "#field-names" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.scute",
          "match": "//.*$"
        },
        {
          "name": "comment.block.scute",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.scute" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.scute" } }
        },
        {
          "comment": "# used as a line comment only when not followed by {",
          "name": "comment.line.number-sign.scute",
          "match": "#(?!\\{).*$"
        }
      ]
    },

    "spawn-declaration": {
      "comment": "spawn \"type:name\" as \"resource-name\" — highlight type and alias separately",
      "patterns": [
        {
          "match": "\\b(spawn!)\\s+(\"[^\"]*\")\\s+(as)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.spawn.protected.scute" },
            "2": { "name": "entity.name.type.resource-type.scute" },
            "3": { "name": "keyword.other.as.scute" },
            "4": { "name": "entity.name.function.resource-name.scute" }
          }
        },
        {
          "match": "\\b(spawn)\\s+(\"[^\"]*\")\\s+(as)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.spawn.scute" },
            "2": { "name": "entity.name.type.resource-type.scute" },
            "3": { "name": "keyword.other.as.scute" },
            "4": { "name": "entity.name.function.resource-name.scute" }
          }
        },
        {
          "comment": "snack \"name\" as \"alias\"",
          "match": "\\b(snack)\\s+(\"[^\"]*\")\\s+(as)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.snack.scute" },
            "2": { "name": "entity.name.type.resource-type.scute" },
            "3": { "name": "keyword.other.as.scute" },
            "4": { "name": "entity.name.function.resource-name.scute" }
          }
        }
      ]
    },

    "mark-declaration": {
      "comment": "mark <name> <type>: <default> — highlight the variable name and type hint",
      "match": "\\b(mark)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\s+(string|number|bool|list|map|any)(?=\\s*:)",
      "captures": {
        "1": { "name": "keyword.declaration.mark.scute" },
        "2": { "name": "variable.other.mark.scute" },
        "3": { "name": "storage.type.scute" }
      }
    },

    "block-keywords": {
      "patterns": [
        {
          "comment": "territory/habitat/signal with their quoted name argument",
          "match": "\\b(territory|habitat|signal)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.declaration.block.scute" },
            "2": { "name": "entity.name.function.block-name.scute" }
          }
        },
        {
          "comment": "standalone block openers",
          "name": "keyword.declaration.block.scute",
          "match": "\\b(territory|habitat|camouflage|signal|snack|export|param|emit|from)\\b"
        },
        {
          "name": "keyword.other.needs.scute",
          "match": "\\bneeds\\b"
        },
        {
          "name": "keyword.other.as.scute",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.other.across.scute",
          "match": "\\bacross\\b"
        },
        {
          "name": "keyword.other.item.scute",
          "match": "\\bitem\\b"
        }
      ]
    },

    "control-keywords": {
      "name": "keyword.control.scute",
      "match": "\\b(when|unless|else)\\b"
    },

    "end-keyword": {
      "name": "keyword.control.end.scute",
      "match": "\\bend\\b"
    },

    "type-hints": {
      "comment": "Type annotations after mark and in type positions",
      "name": "storage.type.scute",
      "match": "\\b(string|number|bool|list|map|any)\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.scute",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.scute",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.scute",
          "match": "\\bnull\\b"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.scute",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.scute",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.scute",
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.scute" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.scute" }
          },
          "contentName": "meta.embedded.scute",
          "patterns": [
            { "include": "#resource-refs" },
            { "include": "#builtin-functions" },
            { "include": "#constants" },
            { "include": "#numbers" },
            {
              "name": "variable.other.interpolated.scute",
              "match": "[a-zA-Z_][a-zA-Z0-9_-]*"
            }
          ]
        }
      ]
    },

    "raw-strings": {
      "name": "string.quoted.backtick.scute",
      "begin": "`",
      "end": "`"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.scute",
          "match": "-?\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.scute",
          "match": "-?\\b[0-9]+([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },

    "resource-refs": {
      "patterns": [
        {
          "comment": "@resource.field — reference to a specific output field",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_-]*)(\\.)([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.resource-ref.scute" },
            "2": { "name": "variable.other.resource.scute" },
            "3": { "name": "punctuation.accessor.scute" },
            "4": { "name": "variable.other.resource-field.scute" }
          }
        },
        {
          "comment": "@resource — plain resource reference",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "punctuation.definition.resource-ref.scute" },
            "2": { "name": "variable.other.resource.scute" }
          }
        }
      ]
    },

    "builtin-functions": {
      "comment": "Built-in Scute stdlib functions",
      "match": "\\b(env|secret|len|upper|lower|trim|replace|format|join|split|keys|values|merge|base64|sha256|tostring|tonumber|tobool)(?=\\s*\\()",
      "captures": {
        "1": { "name": "support.function.builtin.scute" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.scute",
          "match": "(?<![|])\\|(?![|])"
        },
        {
          "name": "keyword.operator.logical.scute",
          "match": "(&&|\\|\\||\\bnot\\b|\\band\\b|\\bor\\b)"
        },
        {
          "name": "keyword.operator.comparison.scute",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.scute",
          "match": "(\\+|-(?![0-9])|\\*|/)"
        },
        {
          "name": "keyword.operator.ternary.scute",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.range.scute",
          "match": "\\.\\."
        }
      ]
    },

    "field-names": {
      "comment": "Key names before a colon — entity.name.tag so themes color them distinctly",
      "match": "^([ \\t]*)([a-zA-Z_][a-zA-Z0-9_./-]*)([ \\t]*:)(?!:)",
      "captures": {
        "2": { "name": "entity.name.tag.field-name.scute" },
        "3": { "name": "punctuation.separator.key-value.scute" }
      }
    }

  }
}
