{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "#{", "close": "}" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(territory|habitat|spawn!?|mark|camouflage|signal|snack|export|param|emit|when|unless|else|across)\\b",
    "decreaseIndentPattern": "^\\s*end\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_-]*",
  "folding": {
    "markers": {
      "start": "^\\s*(territory|habitat|spawn!?|camouflage|signal|snack|when|unless|else)\\b",
      "end": "^\\s*end\\b"
    }
  }
}
